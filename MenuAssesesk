<style>
  :root{
    --ink:#1c2340;        /* azul-tinta do logo */
    --ink-soft:#2f3a63;
    --gold:#c79a4b;       /* dourado da pena */
    --gold-soft:#e3c98a;
    --paper:#f7f4ec;      /* páginas do livro */
    --paper-line:rgba(28,35,64,.10);
    --white:#ffffff;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{-webkit-text-size-adjust:100%}
  body{
    font-family:"Inter",system-ui,sans-serif;
    color:var(--ink);
    background:
      radial-gradient(120% 60% at 50% -10%, rgba(199,154,75,.18), transparent 60%),
      linear-gradient(180deg,#fbf9f3 0%, #f2ede1 100%);
    min-height:100vh;
    display:flex;
    flex-direction:column;
    align-items:center;
    padding:48px 22px 40px;
  }
  .wrap{width:100%;max-width:440px;display:flex;flex-direction:column;align-items:center}

  /* Cabeçalho */
  .avatar{
    width:110px;height:110px;border-radius:50%;
    background:var(--white);
    display:grid;place-items:center;
    box-shadow:0 8px 30px rgba(28,35,64,.16);
    border:3px solid var(--gold);
    overflow:hidden;
  }
  .avatar img{width:100%;height:100%;object-fit:cover;display:block}
  h1{
    font-family:"Cormorant Garamond",serif;
    font-size:2rem;letter-spacing:.14em;font-weight:600;
    margin:20px 0 4px;color:var(--ink);
  }
  .tag{
    font-size:.82rem;color:var(--ink-soft);
    display:flex;align-items:center;gap:7px;
    text-transform:uppercase;letter-spacing:.12em;
  }
  .tag::before,.tag::after{content:"";width:22px;height:1px;background:var(--gold)}
  .motto{
    font-family:"Cormorant Garamond",serif;
    font-style:italic;font-size:1.15rem;color:var(--gold);
    margin-top:14px;
  }
  .place{font-size:.82rem;color:var(--ink-soft);margin-top:4px}

  /* Links */
  nav{width:100%;margin-top:34px;display:flex;flex-direction:column;gap:14px}
  .link{
    display:flex;align-items:center;gap:16px;
    background:var(--white);
    border:1px solid var(--paper-line);
    border-radius:16px;
    padding:16px 18px;
    text-decoration:none;color:var(--ink);
    box-shadow:0 2px 10px rgba(28,35,64,.05);
    transition:transform .18s ease, box-shadow .18s ease, border-color .18s ease;
  }
  .link:hover,.link:focus-visible{
    transform:translateY(-2px);
    border-color:var(--gold);
    box-shadow:0 10px 24px rgba(28,35,64,.12);
    outline:none;
  }
  .link:focus-visible{outline:2px solid var(--ink);outline-offset:3px}
  .ico{
    flex:0 0 42px;height:42px;border-radius:11px;
    background:linear-gradient(160deg,var(--ink),var(--ink-soft));
    display:grid;place-items:center;color:var(--gold-soft);
  }
  .ico svg{width:20px;height:20px}
  .txt{display:flex;flex-direction:column;min-width:0}
  .txt b{font-size:.98rem;font-weight:600;line-height:1.25}
  .txt span{font-size:.76rem;color:var(--ink-soft);margin-top:2px}
  .chev{margin-left:auto;color:var(--gold);flex:0 0 auto;opacity:.7}

  footer{
    margin-top:38px;font-size:.72rem;color:var(--ink-soft);
    text-align:center;letter-spacing:.04em;line-height:1.6;
  }
  footer a{color:var(--ink);text-decoration:none;border-bottom:1px solid var(--gold)}

  @media (prefers-reduced-motion:reduce){.link{transition:none}}
</style>
</head>
